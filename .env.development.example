# =============================================================================
# GroupDrive Environment Template: DEVELOPMENT (Local Workstation)
# Safe for git check-in. Contains non-production mock defaults.
# =============================================================================

NODE_ENV=development
APP_ENV=development
DEBUG=true

# -----------------------------------------------------------------------------
# Database & In-Memory Store
# -----------------------------------------------------------------------------
# PostgreSQL + PostGIS (local socket or Docker)
DATABASE_URL="postgresql://groupdrive:groupdrive_secret@localhost:5432/groupdrive_db?schema=public"
# Redis (Local Docker instance)
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# Service Ports & Local Origins
# -----------------------------------------------------------------------------
PORT=4000
API_BASE_URL="http://localhost:4000"
BUYER_WEB_URL="http://localhost:3000"
SELLER_WEB_URL="http://localhost:3001"
ADMIN_WEB_URL="http://localhost:3002"
AI_SERVICE_URL="http://localhost:8000"

# -----------------------------------------------------------------------------
# JWT Auth Secrets (Development Mock Keys - DO NOT USE IN PRODUCTION)
# -----------------------------------------------------------------------------
JWT_BUYER_SECRET="dev-insecure-buyer-jwt-secret-key-32chars"
JWT_SELLER_SECRET="dev-insecure-seller-jwt-secret-key-32chars"
JWT_ADMIN_SECRET="dev-insecure-admin-jwt-secret-key-32chars"
MFA_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

# -----------------------------------------------------------------------------
# External Provider Adapters (Mock Mode Enabled for zero-cost local testing)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"
SELLER_ONBOARDING_FEE_PAISE=1999900

SMS_PROVIDER="mock"
FAST2SMS_API_KEY=""

# Object Storage (Local MinIO or Mock)
STORAGE_PROVIDER="minio"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_BUCKET_NAME="groupdrive-dev-bucket"
S3_ACCESS_KEY="groupdrive_s3_admin"
S3_SECRET_KEY="groupdrive_s3_secret_key"
S3_FORCE_PATH_STYLE="true"

# AI Service Settings
DEFAULT_PROVIDER="fallback"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Observability (Disabled in local dev)
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""
