# =============================================================================
# GroupDrive Environment Template: PRODUCTION (Live Bharat Operations)
# STRICT SECURITY NOTICE:
# - NEVER commit populated values into git or store in unencrypted disk files.
# - Inject all values marked <SECRETS_MANAGER:KEY> at container startup via:
#   * AWS Secrets Manager (ARN: arn:aws:secretsmanager:ap-south-1:123456789012:secret:groupdrive/production)
#   * Doppler / HashiCorp Vault / Kubernetes Secrets
# =============================================================================

NODE_ENV=production
APP_ENV=production
DEBUG=false

# -----------------------------------------------------------------------------
# High-Availability Database & Cache
# -----------------------------------------------------------------------------
# AWS RDS PostgreSQL 16 Multi-AZ with PostGIS in ap-south-1 (Mumbai)
DATABASE_URL="postgresql://groupdrive_master:<SECRETS_MANAGER:DATABASE_PASSWORD>@db-prod.internal.groupdrive.in:5432/groupdrive_prod?schema=public&sslmode=require&connection_limit=50&pool_timeout=10"

# AWS ElastiCache Redis Cluster (Multi-AZ with In-Transit & At-Rest Encryption)
REDIS_URL="rediss://default:<SECRETS_MANAGER:REDIS_AUTH_TOKEN>@redis-prod.internal.groupdrive.in:6379"

# -----------------------------------------------------------------------------
# Production Domains & Strict HTTPS Origins
# -----------------------------------------------------------------------------
PORT=4000
API_BASE_URL="https://api.groupdrive.in"
BUYER_WEB_URL="https://groupdrive.in"
SELLER_WEB_URL="https://dealer.groupdrive.in"
ADMIN_WEB_URL="https://ops.groupdrive.in"
AI_SERVICE_URL="https://ai.internal.groupdrive.in:8000"

# -----------------------------------------------------------------------------
# Cryptographic Authentication Secrets (Rotated every 90 days via KMS)
# Minimum 64 characters of high-entropy base64 randomness
# -----------------------------------------------------------------------------
JWT_BUYER_SECRET="<SECRETS_MANAGER:JWT_BUYER_SECRET_64CHARS>"
JWT_SELLER_SECRET="<SECRETS_MANAGER:JWT_SELLER_SECRET_64CHARS>"
JWT_ADMIN_SECRET="<SECRETS_MANAGER:JWT_ADMIN_SECRET_64CHARS>"
MFA_ENCRYPTION_KEY="<SECRETS_MANAGER:MFA_ENCRYPTION_KEY_32BYTES_HEX>"

# -----------------------------------------------------------------------------
# Production Banking & Payment Gateway (Razorpay India Live Mode)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER="razorpay"
RAZORPAY_KEY_ID="rzp_live_<SECRETS_MANAGER:RAZORPAY_LIVE_KEY_ID>"
RAZORPAY_KEY_SECRET="<SECRETS_MANAGER:RAZORPAY_LIVE_SECRET_KEY>"
RAZORPAY_WEBHOOK_SECRET="<SECRETS_MANAGER:RAZORPAY_LIVE_WEBHOOK_SECRET>"
SELLER_ONBOARDING_FEE_PAISE=1999900

# -----------------------------------------------------------------------------
# Production Telecom & Messaging (DLT Registered SMS & WhatsApp Business)
# -----------------------------------------------------------------------------
SMS_PROVIDER="fast2sms"
FAST2SMS_API_KEY="<SECRETS_MANAGER:FAST2SMS_PROD_API_KEY>"
WHATSAPP_BUSINESS_TOKEN="<SECRETS_MANAGER:META_WHATSAPP_PROD_TOKEN>"
WHATSAPP_PHONE_NUMBER_ID="<SECRETS_MANAGER:META_PHONE_ID>"

# -----------------------------------------------------------------------------
# Scalable Object Storage (AWS S3 + CloudFront CDN Edge)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER="s3"
S3_REGION="ap-south-1"
S3_BUCKET_NAME="groupdrive-prod-vault-mumbai"
S3_ACCESS_KEY="<SECRETS_MANAGER:AWS_S3_APP_ACCESS_KEY>"
S3_SECRET_KEY="<SECRETS_MANAGER:AWS_S3_APP_SECRET_KEY>"
S3_FORCE_PATH_STYLE="false"
CLOUDFRONT_DISTRIBUTION_DOMAIN="https://cdn.groupdrive.in"

# -----------------------------------------------------------------------------
# Production AI Advisory Models
# -----------------------------------------------------------------------------
DEFAULT_PROVIDER="gemini"
GEMINI_API_KEY="<SECRETS_MANAGER:GOOGLE_GEMINI_PRODUCTION_KEY>"
OPENAI_API_KEY="<SECRETS_MANAGER:OPENAI_PRODUCTION_KEY>"

# -----------------------------------------------------------------------------
# Observability, APM & Sentry Alerting
# -----------------------------------------------------------------------------
SENTRY_DSN="https://prod_key@o450000.ingest.sentry.io/prod-project-id"
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE="0.20"
OTEL_EXPORTER_OTLP_ENDPOINT="https://otel-collector.internal.groupdrive.in:4318"
OTEL_SERVICE_NAME="groupdrive-production"
