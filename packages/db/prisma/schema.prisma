datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ==============================================================================
// ENUMS
// ==============================================================================

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum SellerKycStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  REJECTED
}

enum SellerRegistrationFeeStatus {
  UNPAID
  PAID
  EXEMPT
}

enum KycDocumentType {
  GST_CERTIFICATE
  PAN_CARD
  DEALERSHIP_AGREEMENT
  TRADE_CERTIFICATE
  CANCELLED_CHEQUE
}

enum KycVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ZoneLevel {
  STATE
  DISTRICT
  TALUKA
  VILLAGE_PINCODE
}

enum ZoneDensityClass {
  METRO
  URBAN
  SEMI_URBAN
  RURAL
  DEEP_RURAL
}

enum VehicleBodyType {
  HATCHBACK
  SEDAN
  COMPACT_SUV
  SUV
  MUV
  EV
}

enum VehicleFuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

enum VehicleTransmission {
  MANUAL
  AUTOMATIC
  AMT
  CVT
  DCT
}

enum VehicleConditionType {
  CLEARANCE
  DEMO
  PREVIOUS_YEAR
}

enum GroupStatus {
  DRAFT
  FORMING
  QUORUM_REACHED
  RFQ_ACTIVE
  VOTING_OPEN
  DEAL_LOCKED
  FULFILLMENT
  COMPLETED
  CANCELLED
}

enum MembershipStatus {
  ACTIVE
  VOTED
  CONFIRMED
  WITHDRAWN
  REFUNDED
}

enum RfqStatus {
  SEALED_BIDDING
  EVALUATION
  VOTING_OPEN
  AWARDED
  NO_DEAL
  CANCELLED
}

enum QuoteStatus {
  SEALED
  UNSEALED
  NORMALIZED
  ACCEPTED
  REJECTED
}

enum QuoteLineItemCategory {
  EX_SHOWROOM
  LOGISTICS
  RTO_TAX
  INSURANCE
  ACCESSORIES
  DISCOUNT
}

enum BookingStatus {
  TOKEN_CONFIRMED
  DEALER_ACCEPTED
  CHASSIS_ALLOCATED
  INVOICED
  REGISTRATION_COMPLETE
  DELIVERY_IN_PROGRESS
  FULFILLED
  CANCELLED
}

enum PaymentType {
  TOKEN_HOLD
  DOWN_PAYMENT
  FULL_PAYMENT
  SELLER_ONBOARDING_FEE
}

enum PaymentStatus {
  INITIATED
  CAPTURED
  FAILED
  REFUNDED
  PENDING
}

enum PaymentGatewayProvider {
  RAZORPAY
  CASHFREE
  MOCK
}

enum SettlementStatus {
  PENDING
  PROCESSED
  DISPUTED
}

enum DeliveryStatus {
  DISPATCHED
  IN_TRANSIT
  ARRIVED_ZONE
  DOORSTEP_DELIVERED
}

enum OfferEnquiryStatus {
  ENQUIRED
  TOKEN_HELD
  CONVERTED
  EXPIRED
}

enum LedgerAccountType {
  BUYER_ESCROW_HOLD
  PLATFORM_REVENUE
  SELLER_RECEIVABLE
  TAX_PAYABLE
}

enum NotificationChannel {
  SMS
  WHATSAPP
  IN_APP
}

// ==============================================================================
// 1. IDENTITY & USER PROFILES
// ==============================================================================

model User {
  id           String        @id @default(uuid())
  email        String?       @unique
  phone        String        @unique
  passwordHash String?
  role         UserRole      @default(BUYER)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  buyerProfile  BuyerProfile?
  sellerProfile SellerProfile?
  notifications Notification[]

  @@index([role])
  @@index([phone])
  @@index([email])
}

model BuyerProfile {
  id             String        @id @default(uuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  primaryZoneId  String?
  primaryZone    Zone?         @relation("BuyerPrimaryZone", fields: [primaryZoneId], references: [id])
  pincode        String?
  alternatePhone String?
  address        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  memberships    Membership[]
  votes          Vote[]
  offerEnquiries OfferEnquiry[]
  reviews        Review[]

  @@index([primaryZoneId])
}

model SellerProfile {
  id                     String                      @id @default(uuid())
  userId                 String                      @unique
  user                   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealershipLegalName    String
  tradeName              String
  gstin                  String                      @unique
  panNumber              String
  cinNumber              String?
  kycStatus              SellerKycStatus             @default(DRAFT)
  registrationFeeStatus  SellerRegistrationFeeStatus @default(UNPAID)
  commissionRatePercent  Decimal                     @default(1.00) @db.Decimal(5, 2)
  primaryContactName     String
  primaryContactPhone    String
  rejectionReason        String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  branches               SellerBranch[]
  brandAuthorizations    SellerBrandAuthorization[]
  kycDocuments           SellerKyc[]
  registrationPayments   SellerRegistrationPayment[]
  quotes                 Quote[]
  offeredVehicles        OfferedVehicle[]
  settlements            Settlement[]
  rfqEligibilities       RFQEligibility[]
  reviews                Review[]

  @@index([kycStatus])
  @@index([registrationFeeStatus])
  @@index([gstin])
}

model SellerBranch {
  id             String         @id @default(uuid())
  sellerProfileId String
  sellerProfile  SellerProfile  @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  branchName     String
  zoneId         String
  zone           Zone           @relation(fields: [zoneId], references: [id])
  address        String
  pincode        String
  latitude       Float
  longitude      Float
  contactPhone   String
  isHeadquarters Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  quotes               Quote[]
  offeredVehicles      OfferedVehicle[]
  shipmentsDispatched  DeliveryShipment[]

  @@index([zoneId])
  @@index([sellerProfileId])
}

model SellerBrandAuthorization {
  id              String        @id @default(uuid())
  sellerProfileId String
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  brandId         String
  brand           Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  certificateUrl  String
  validFrom       DateTime
  validUntil      DateTime
  isVerified      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([sellerProfileId, brandId])
  @@index([brandId])
}

model SellerKyc {
  id                 String                @id @default(uuid())
  sellerProfileId    String
  sellerProfile      SellerProfile         @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  documentType       KycDocumentType
  documentUrl        String
  verificationStatus KycVerificationStatus @default(PENDING)
  rejectionReason    String?
  verifiedByUserId   String?
  verifiedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([sellerProfileId])
  @@index([verificationStatus])
}

model SellerRegistrationPayment {
  id                 String                 @id @default(uuid())
  sellerProfileId    String
  sellerProfile      SellerProfile          @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  amountPaise        BigInt                 @default(1999900)
  gstAmountPaise     BigInt                 @default(359982)
  totalAmountPaise   BigInt                 @default(2359882)
  status             PaymentStatus          @default(PENDING)
  gatewayProvider    PaymentGatewayProvider @default(MOCK)
  gatewayPaymentRef  String?
  paidAt             DateTime?
  createdAt          DateTime               @default(now())

  @@index([sellerProfileId])
  @@index([status])
}

// ==============================================================================
// 2. ZONE HIERARCHY & SPATIAL TOPOLOGY
// ==============================================================================

model Zone {
  id           String           @id @default(uuid())
  parentId     String?
  parent       Zone?            @relation("ZoneHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Zone[]           @relation("ZoneHierarchy")
  name         String
  code         String
  level        ZoneLevel
  densityClass ZoneDensityClass @default(RURAL)
  pincode      String?
  latitude     Float?
  longitude    Float?
  metadata     Json?
  createdAt    DateTime         @default(now())

  buyerProfiles         BuyerProfile[]         @relation("BuyerPrimaryZone")
  sellerBranches        SellerBranch[]
  groups                Group[]
  stateTaxConfigs       StateTaxConfig[]
  variantCityPrices     VariantCityPrice[]
  destinationShipments  DeliveryShipment[]
  clusters              ZoneCluster[]          @relation("ZoneClusterMembers")
  leadClusters          ZoneCluster[]          @relation("LeadTaluka")

  @@unique([parentId, code])
  @@index([level])
  @@index([pincode])
  @@index([densityClass])
}

model ZoneCluster {
  id           String   @id @default(uuid())
  name         String
  leadTalukaId String
  leadTaluka   Zone     @relation("LeadTaluka", fields: [leadTalukaId], references: [id])
  radiusKm     Int      @default(50)
  description  String?
  createdAt    DateTime @default(now())

  zones        Zone[]   @relation("ZoneClusterMembers")

  @@index([leadTalukaId])
}

// ==============================================================================
// 3. VEHICLE CATALOG
// ==============================================================================

model Brand {
  id              String                     @id @default(uuid())
  name            String                     @unique
  slug            String                     @unique
  logoUrl         String?
  countryOfOrigin String                     @default("India")
  isActive        Boolean                    @default(true)

  models          CarModel[]
  sellerAuthorizations SellerBrandAuthorization[]
}

model CarModel {
  id        String          @id @default(uuid())
  brandId   String
  brand     Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  bodyType  VehicleBodyType
  isActive  Boolean         @default(true)

  variants  Variant[]

  @@unique([brandId, slug])
}

model Variant {
  id                     String              @id @default(uuid())
  carModelId            String
  carModel               CarModel            @relation(fields: [carModelId], references: [id], onDelete: Cascade)
  name                   String
  fuelType               VehicleFuelType
  transmission           VehicleTransmission
  engineCc               Int?
  batteryKwh             Decimal?            @db.Decimal(5, 2)
  seatingCapacity        Int                 @default(5)
  baseExShowroomPaise    BigInt
  imageUrl               String?
  isActive               Boolean             @default(true)

  cityPrices             VariantCityPrice[]
  groups                 Group[]
  offeredVehicles        OfferedVehicle[]

  @@unique([carModelId, name, fuelType, transmission])
}

model VariantCityPrice {
  id              String   @id @default(uuid())
  variantId       String
  variant         Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  zoneId          String
  zone            Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  exShowroomPaise BigInt
  effectiveDate   DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([variantId, zoneId])
}

// ==============================================================================
// 4. GROUP DEMAND & REVERSE AUCTION (RFQ)
// ==============================================================================

model Group {
  id               String       @id @default(uuid())
  variantId        String
  variant          Variant      @relation(fields: [variantId], references: [id])
  targetZoneId     String
  targetZone       Zone         @relation(fields: [targetZoneId], references: [id])
  targetCount      Int          @default(5)
  currentCount     Int          @default(0)
  status           GroupStatus  @default(FORMING)
  deadline         DateTime
  quorumReachedAt  DateTime?
  dealLockedAt     DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  memberships      Membership[]
  rfq              RFQ?

  @@index([status])
  @@index([targetZoneId])
  @@index([deadline])
}

model Membership {
  id             String           @id @default(uuid())
  groupId        String
  group          Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  buyerProfileId String
  buyerProfile   BuyerProfile     @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)
  tokenPaidPaise BigInt           @default(500000)
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())

  preference     GroupPreference?
  vote           Vote?
  booking        Booking?

  @@unique([groupId, buyerProfileId])
  @@index([status])
}

model GroupPreference {
  id                String           @id @default(uuid())
  membershipId      String           @unique
  membership        Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  preferredColor    String?
  preferredFuel     VehicleFuelType?
  accessoriesNeeded Json?
  notes             String?
}

model RFQ {
  id                String           @id @default(uuid())
  groupId           String           @unique
  group             Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  rfqNumber         String           @unique
  status            RfqStatus        @default(SEALED_BIDDING)
  bidWindowClosesAt DateTime
  votingClosesAt    DateTime?
  winningQuoteId    String?          @unique
  winningQuote      Quote?           @relation("WinningQuote", fields: [winningQuoteId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  eligibilities     RFQEligibility[]
  quotes            Quote[]          @relation("RfqQuotes")
  votes             Vote[]

  @@index([status])
  @@index([bidWindowClosesAt])
  @@index([votingClosesAt])
}

model RFQEligibility {
  id              String        @id @default(uuid())
  rfqId           String
  rfq             RFQ           @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  sellerProfileId String
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  maxTransitKm    Int           @default(300)
  isNotified      Boolean       @default(false)
  eligibleAt      DateTime      @default(now())

  @@unique([rfqId, sellerProfileId])
  @@index([sellerProfileId])
}

model Quote {
  id                         String            @id @default(uuid())
  rfqId                      String
  rfq                        RFQ               @relation("RfqQuotes", fields: [rfqId], references: [id], onDelete: Cascade)
  sellerProfileId            String
  sellerProfile              SellerProfile     @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  branchId                   String
  branch                     SellerBranch      @relation(fields: [branchId], references: [id])
  status                     QuoteStatus       @default(SEALED)
  exShowroomPaise            BigInt
  batchGroupDiscountPaise    BigInt
  dealerLogisticsToZonePaise BigInt
  roadTaxRtoPaise            BigInt
  insuranceEstimatePaise     BigInt
  fastagRegistrationCessPaise BigInt
  tcsPaise                   BigInt
  totalLandedCostPaise       BigInt
  deliveryTimelineDays       Int
  validityDate               DateTime
  notes                      String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  lineItems                  QuoteLineItem[]
  votes                      Vote[]
  wonRfq                     RFQ?              @relation("WinningQuote")
  bookings                   Booking[]

  @@index([rfqId])
  @@index([sellerProfileId])
  @@index([status])
  @@index([totalLandedCostPaise])
}

model QuoteLineItem {
  id          String                @id @default(uuid())
  quoteId     String
  quote       Quote                 @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  category    QuoteLineItemCategory
  description String
  amountPaise BigInt
  isMandatory Boolean               @default(true)

  @@index([quoteId])
}

model Vote {
  id             String       @id @default(uuid())
  rfqId          String
  rfq            RFQ          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  membershipId   String       @unique
  membership     Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  quoteId        String
  quote          Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  buyerProfileId String
  buyerProfile   BuyerProfile @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)
  votedAt        DateTime     @default(now())

  @@index([rfqId])
  @@index([quoteId])
}

// ==============================================================================
// 5. BOOKING, PAYMENTS & SETTLEMENTS
// ==============================================================================

model Booking {
  id                 String         @id @default(uuid())
  bookingNumber      String         @unique
  membershipId       String?        @unique
  membership         Membership?    @relation(fields: [membershipId], references: [id])
  quoteId            String?
  quote              Quote?         @relation(fields: [quoteId], references: [id])
  offeredVehicleId   String?        @unique
  offeredVehicle     OfferedVehicle? @relation(fields: [offeredVehicleId], references: [id])
  status             BookingStatus  @default(TOKEN_CONFIRMED)
  totalOnRoadPaise   BigInt
  tokenAmountPaise   BigInt
  balanceAmountPaise BigInt
  chassisNumber      String?
  registrationNumber String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  payments           Payment[]
  settlement         Settlement?
  shipment           DeliveryShipment?
  ledgerEntries      LedgerEntry[]
  review             Review?

  @@index([status])
  @@index([createdAt])
}

model Payment {
  id                    String                 @id @default(uuid())
  bookingId             String
  booking               Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId                String
  amountPaise           BigInt
  paymentType           PaymentType
  status                PaymentStatus          @default(INITIATED)
  gatewayProvider       PaymentGatewayProvider @default(MOCK)
  gatewayTransactionRef String?
  paymentMetadata       Json?
  createdAt             DateTime               @default(now())

  @@index([bookingId])
  @@index([status])
}

model Settlement {
  id                      String           @id @default(uuid())
  bookingId               String           @unique
  booking                 Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sellerProfileId         String
  sellerProfile           SellerProfile    @relation(fields: [sellerProfileId], references: [id])
  grossDealValuePaise     BigInt
  commissionPercent       Decimal          @default(1.00) @db.Decimal(5, 2)
  platformCommissionPaise BigInt
  netPayableToSellerPaise BigInt
  status                  SettlementStatus @default(PENDING)
  settledAt               DateTime?
  createdAt               DateTime         @default(now())

  @@index([sellerProfileId])
  @@index([status])
}

model DeliveryShipment {
  id                  String             @id @default(uuid())
  bookingId           String             @unique
  booking             Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  logisticsProvider   String
  driverName          String?
  driverPhone         String?
  trackingNumber      String?
  originBranchId      String
  originBranch        SellerBranch       @relation(fields: [originBranchId], references: [id])
  destinationZoneId   String
  destinationZone     Zone               @relation(fields: [destinationZoneId], references: [id])
  status              DeliveryStatus     @default(DISPATCHED)
  estimatedDeliveryAt DateTime
  actualDeliveredAt   DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  milestones          ShipmentMilestone[]

  @@index([status])
  @@index([destinationZoneId])
}

model ShipmentMilestone {
  id            String           @id @default(uuid())
  shipmentId    String
  shipment      DeliveryShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  locationName  String
  proofPhotoUrl String?
  timestamp     DateTime         @default(now())

  @@index([shipmentId])
}

// ==============================================================================
// 6. OFFERED VEHICLES (CLEARANCE & DEMO STOCK)
// ==============================================================================

model OfferedVehicle {
  id                    String               @id @default(uuid())
  sellerProfileId       String
  sellerProfile         SellerProfile        @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  branchId              String
  branch                SellerBranch         @relation(fields: [branchId], references: [id])
  variantId             String
  variant               Variant              @relation(fields: [variantId], references: [id])
  vin                   String               @unique
  manufactureYear       Int
  conditionType         VehicleConditionType
  odometerKm            Int                  @default(0)
  color                 String
  regularPricePaise     BigInt
  discountedPricePaise  BigInt
  imageUrl              String
  galleryUrls           Json?
  isAvailable           Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  enquiries             OfferEnquiry[]
  booking               Booking?

  @@index([isAvailable])
  @@index([variantId])
  @@index([conditionType])
}

model OfferEnquiry {
  id                 String             @id @default(uuid())
  offeredVehicleId   String
  offeredVehicle     OfferedVehicle     @relation(fields: [offeredVehicleId], references: [id], onDelete: Cascade)
  buyerProfileId     String
  buyerProfile       BuyerProfile       @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)
  destinationZoneId  String
  status             OfferEnquiryStatus @default(ENQUIRED)
  tokenAmountPaise   BigInt             @default(500000)
  createdAt          DateTime           @default(now())

  @@index([offeredVehicleId])
  @@index([status])
}

// ==============================================================================
// 7. REVIEWS, IMMUTABLE LEDGER, AUDIT & TAX
// ==============================================================================

model Review {
  id              String        @id @default(uuid())
  bookingId       String        @unique
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  buyerProfileId  String
  buyerProfile    BuyerProfile  @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)
  sellerProfileId String
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  rating          Int
  title           String
  comment         String
  createdAt       DateTime      @default(now())

  @@index([sellerProfileId])
  @@index([rating])
}

model LedgerEntry {
  id                String            @id @default(uuid())
  entryNumber       Int               @default(autoincrement()) @unique
  accountType       LedgerAccountType
  bookingId         String?
  booking           Booking?          @relation(fields: [bookingId], references: [id])
  actorId           String?
  debitPaise        BigInt            @default(0)
  creditPaise       BigInt            @default(0)
  balanceAfterPaise BigInt
  narration         String
  createdAt         DateTime          @default(now())

  @@index([accountType])
  @@index([bookingId])
  @@index([createdAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorType     UserRole
  actorId       String
  action        String
  entityType    String
  entityId      String
  previousState String?
  newState      String?
  ipAddress     String?
  payloadDiff   Json?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  title     String
  message   String
  isRead    Boolean             @default(false)
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId])
  @@index([isRead])
}

model StateTaxConfig {
  id                String          @id @default(uuid())
  zoneId            String
  zone              Zone            @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  fuelType          VehicleFuelType
  minPricePaise     BigInt
  maxPricePaise     BigInt
  taxPercent        Decimal         @db.Decimal(5, 2)
  flatFeePaise      BigInt          @default(0)
  needsVerification Boolean         @default(true)
  verifiedAt        DateTime?
  verifiedByUserId  String?
  updatedAt         DateTime        @updatedAt

  @@unique([zoneId, fuelType, minPricePaise, maxPricePaise])
  @@index([needsVerification])
}
