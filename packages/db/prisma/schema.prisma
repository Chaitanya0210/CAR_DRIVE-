datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum SellerKybStatus {
  REGISTERED
  KYB_PENDING
  KYB_VERIFIED
  KYB_REJECTED
  FEE_PENDING
  ACTIVE
  SUSPENDED
}

enum GroupStatus {
  DRAFT
  FORMING
  QUORUM_REACHED
  RFQ_ACTIVE
  VOTING_OPEN
  DEAL_LOCKED
  FULFILLMENT
  COMPLETED
  CANCELLED
}

enum RfqStatus {
  SEALED_BIDDING
  EVALUATION
  VOTING_OPEN
  ACCEPTED
  REJECTED
  CANCELLED
}

enum QuoteStatus {
  SEALED
  UNSEALED
  NORMALIZED
  ACCEPTED
  REJECTED
}

enum VehicleFuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

enum VehicleConditionType {
  CLEARANCE
  DEMO
  PREVIOUS_YEAR
}

model Buyer {
  id          String        @id @default(uuid())
  phone       String        @unique
  name        String?
  pincode     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  memberships GroupMember[]
  votes       QuoteVote[]

  @@index([phone])
}

model Seller {
  id                         String           @id @default(uuid())
  dealershipName             String
  email                      String           @unique
  passwordHash               String
  contactPhone               String
  mfaSecret                  String?
  mfaEnabled                 Boolean          @default(false)
  kybStatus                  SellerKybStatus  @default(REGISTERED)
  kybRejectionReason         String?
  gstin                      String?          @unique
  panNumber                  String?
  tradeCertificateUrl        String?
  dealershipAuthorizationUrl String?
  registrationFeePaid        Boolean          @default(false)
  registrationFeeTxId        String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  quotes                     DealerQuote[]
  offeredVehicles            OfferedVehicle[]

  @@index([email])
  @@index([kybStatus])
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ----------------------------------------------------
// Geographic Zone Hierarchy (State > District > Taluka > Pincode)
// ----------------------------------------------------

model State {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  gstStateCode    Int
  districts       District[]
  rtoZoneConfigs  RtoZoneConfig[]
  offeredVehicles OfferedVehicle[]
}

model District {
  id        String   @id @default(uuid())
  stateId   String
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  code      String
  name      String
  talukas   Taluka[]

  @@unique([stateId, code])
}

model Taluka {
  id         String             @id @default(uuid())
  districtId String
  district   District           @relation(fields: [districtId], references: [id], onDelete: Cascade)
  name       String
  isRural    Boolean            @default(true)
  pincodes   PincodeDirectory[]
  groups     GroupDemand[]

  @@unique([districtId, name])
}

model PincodeDirectory {
  pincode   String  @id
  talukaId  String
  taluka    Taluka  @relation(fields: [talukaId], references: [id], onDelete: Cascade)
  latitude  Float?
  longitude Float?

  @@index([talukaId])
}

// ----------------------------------------------------
// Vehicle Catalog Models
// ----------------------------------------------------

model CarMake {
  id        String     @id @default(uuid())
  name      String     @unique
  logoUrl   String?
  models    CarModel[]
}

model CarModel {
  id       String       @id @default(uuid())
  makeId   String
  make     CarMake      @relation(fields: [makeId], references: [id], onDelete: Cascade)
  name     String
  variants CarVariant[]

  @@unique([makeId, name])
}

model CarVariant {
  id                     String           @id @default(uuid())
  modelId                String
  model                  CarModel         @relation(fields: [modelId], references: [id], onDelete: Cascade)
  name                   String
  fuelType               VehicleFuelType
  transmission           String
  engineCc               Int
  standardExShowroomPaise BigInt
  imageUrl               String?
  groups                 GroupDemand[]
  offeredVehicles        OfferedVehicle[]

  @@unique([modelId, name, fuelType])
}

// ----------------------------------------------------
// Group Demand & Reverse Auction (RFQ)
// ----------------------------------------------------

model GroupDemand {
  id               String               @id @default(uuid())
  variantId        String
  variant          CarVariant           @relation(fields: [variantId], references: [id])
  talukaId         String
  taluka           Taluka               @relation(fields: [talukaId], references: [id])
  targetPincode    String
  targetBuyers     Int
  currentBuyerCount Int                 @default(0)
  status           GroupStatus          @default(FORMING)
  deadline         DateTime
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  members          GroupMember[]
  rfq              ReverseAuctionRfq?

  @@index([status])
  @@index([talukaId])
}

model GroupMember {
  id             String      @id @default(uuid())
  groupId        String
  group          GroupDemand @relation(fields: [groupId], references: [id], onDelete: Cascade)
  buyerId        String
  buyer          Buyer       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  preferredColor String?
  joinedAt       DateTime    @default(now())

  @@unique([groupId, buyerId])
}

model ReverseAuctionRfq {
  id                  String        @id @default(uuid())
  groupId             String        @unique
  group               GroupDemand   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status              RfqStatus     @default(SEALED_BIDDING)
  sealedBidsCloseAt   DateTime
  votingClosesAt      DateTime?
  winningQuoteId      String?       @unique
  winningQuote        DealerQuote?  @relation("WinningQuote", fields: [winningQuoteId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  quotes              DealerQuote[] @relation("RfqQuotes")
}

model DealerQuote {
  id                         String             @id @default(uuid())
  rfqId                      String
  rfq                        ReverseAuctionRfq  @relation("RfqQuotes", fields: [rfqId], references: [id], onDelete: Cascade)
  sellerId                   String
  seller                     Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  status                     QuoteStatus        @default(SEALED)
  exShowroomPaise            BigInt
  batchGroupDiscountPaise    BigInt
  dealerLogisticsToZonePaise BigInt
  roadTaxRtoPaise            BigInt
  insuranceEstimatePaise     BigInt
  fastagRegistrationCessPaise BigInt
  tcsPaise                   BigInt
  totalLandedCostPaise       BigInt
  deliveryTimelineDays       Int
  notes                      String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  votes                      QuoteVote[]
  wonRfq                     ReverseAuctionRfq? @relation("WinningQuote")

  @@index([rfqId])
  @@index([sellerId])
}

model QuoteVote {
  id        String      @id @default(uuid())
  quoteId   String
  quote     DealerQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     Buyer       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  votedAt   DateTime    @default(now())

  @@unique([quoteId, buyerId])
}

// ----------------------------------------------------
// Offered Vehicles (Clearance / Demo Stock)
// ----------------------------------------------------

model OfferedVehicle {
  id                        String               @id @default(uuid())
  sellerId                  String
  seller                    Seller               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  variantId                 String
  variant                   CarVariant           @relation(fields: [variantId], references: [id])
  vin                       String               @unique
  manufactureYear           Int
  conditionType             VehicleConditionType
  odometerKm                Int                  @default(0)
  color                     String
  regularExShowroomPaise    BigInt
  discountedExShowroomPaise BigInt
  imageUrl                  String
  isAvailable               Boolean              @default(true)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  eligibleStates            State[]

  @@index([isAvailable])
  @@index([variantId])
}

// ----------------------------------------------------
// Tax & Regulatory Configs (Needs Verification)
// ----------------------------------------------------

model TaxRuleConfig {
  id                String   @id @default(uuid())
  ruleKey           String   @unique
  description       String
  ratePercent       Decimal  @db.Decimal(5, 2)
  flatFeePaise      BigInt   @default(0)
  needsVerification Boolean  @default(true)
  verifiedAt        DateTime?
  verifiedByAdminId String?
  updatedAt         DateTime @updatedAt
}

model RtoZoneConfig {
  id                String          @id @default(uuid())
  stateId           String
  state             State           @relation(fields: [stateId], references: [id], onDelete: Cascade)
  fuelType          VehicleFuelType
  minPricePaise     BigInt
  maxPricePaise     BigInt
  taxPercent        Decimal         @db.Decimal(5, 2)
  needsVerification Boolean         @default(true)
  verifiedAt        DateTime?
  updatedAt         DateTime        @updatedAt

  @@unique([stateId, fuelType, minPricePaise, maxPricePaise])
}

// ----------------------------------------------------
// Immutable Audit Log
// ----------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  actorType     UserRole
  actorId       String
  action        String
  entityType    String
  entityId      String
  previousState String?
  newState      String?
  ipAddress     String?
  payloadDiff   Json?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
