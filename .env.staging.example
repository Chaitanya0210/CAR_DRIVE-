# =============================================================================
# GroupDrive Environment Template: STAGING (Pre-Production Validation)
# Connected to cloud sandbox services; sanitised test credentials only.
# Values marked with <SECRET_MANAGER_KEY> must be loaded via Doppler or AWS Secrets Manager.
# =============================================================================

NODE_ENV=production
APP_ENV=staging
DEBUG=false

# -----------------------------------------------------------------------------
# Managed Cloud Database & Cache
# -----------------------------------------------------------------------------
# AWS RDS Aurora / Railway / Neon PostgreSQL with PostGIS
DATABASE_URL="postgresql://groupdrive_staging_user:<SECRET_MANAGER_KEY_STAGING_DB_PASSWORD>@db-staging.internal.groupdrive.in:5432/groupdrive_staging?schema=public&sslmode=require&connection_limit=20"

# AWS ElastiCache / Upstash Staging Redis
REDIS_URL="rediss://default:<SECRET_MANAGER_KEY_STAGING_REDIS_PASSWORD>@redis-staging.internal.groupdrive.in:6379"

# -----------------------------------------------------------------------------
# Staging Domains & Ingress URLs
# -----------------------------------------------------------------------------
PORT=4000
API_BASE_URL="https://api.staging.groupdrive.in"
BUYER_WEB_URL="https://staging.groupdrive.in"
SELLER_WEB_URL="https://dealer.staging.groupdrive.in"
ADMIN_WEB_URL="https://ops.staging.groupdrive.in"
AI_SERVICE_URL="https://ai.staging.groupdrive.in"

# -----------------------------------------------------------------------------
# Cryptographic Authentication Secrets (Injected from Secrets Manager)
# -----------------------------------------------------------------------------
JWT_BUYER_SECRET="<SECRET_MANAGER_KEY_STAGING_JWT_BUYER_SECRET>"
JWT_SELLER_SECRET="<SECRET_MANAGER_KEY_STAGING_JWT_SELLER_SECRET>"
JWT_ADMIN_SECRET="<SECRET_MANAGER_KEY_STAGING_JWT_ADMIN_SECRET>"
MFA_ENCRYPTION_KEY="<SECRET_MANAGER_KEY_STAGING_MFA_KEY_32BYTES_HEX>"

# -----------------------------------------------------------------------------
# Staging Third-Party Providers (Sanctioned Test / Sandbox Accounts)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER="razorpay"
RAZORPAY_KEY_ID="rzp_test_<SECRET_MANAGER_KEY_STAGING_RAZORPAY_KEY_ID>"
RAZORPAY_KEY_SECRET="<SECRET_MANAGER_KEY_STAGING_RAZORPAY_SECRET>"
RAZORPAY_WEBHOOK_SECRET="<SECRET_MANAGER_KEY_STAGING_WEBHOOK_SECRET>"
SELLER_ONBOARDING_FEE_PAISE=1999900

SMS_PROVIDER="fast2sms"
FAST2SMS_API_KEY="<SECRET_MANAGER_KEY_STAGING_FAST2SMS_KEY>"

# Cloud Object Storage (S3 / Cloudflare R2 Staging Bucket)
STORAGE_PROVIDER="s3"
S3_REGION="ap-south-1"
S3_BUCKET_NAME="groupdrive-staging-assets-mumbai"
S3_ACCESS_KEY="<SECRET_MANAGER_KEY_STAGING_AWS_ACCESS_KEY>"
S3_SECRET_KEY="<SECRET_MANAGER_KEY_STAGING_AWS_SECRET_KEY>"
S3_FORCE_PATH_STYLE="false"
CLOUDFRONT_DISTRIBUTION_DOMAIN="https://assets-staging.groupdrive.in"

# AI RAG Service (Gemini Sandbox Project)
DEFAULT_PROVIDER="gemini"
GEMINI_API_KEY="<SECRET_MANAGER_KEY_STAGING_GEMINI_KEY>"
OPENAI_API_KEY="<SECRET_MANAGER_KEY_STAGING_OPENAI_KEY>"

# Telemetry & Error Tracking
SENTRY_DSN="https://staging_key@o450000.ingest.sentry.io/staging-project-id"
SENTRY_ENVIRONMENT="staging"
OTEL_EXPORTER_OTLP_ENDPOINT="https://otel-collector.staging.groupdrive.in:4318"
OTEL_SERVICE_NAME="groupdrive-staging"
