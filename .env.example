# ==============================================
# GroupDrive Global Environment Configuration
# ==============================================

# Database (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://groupdrive:groupdrive_secret@localhost:5432/groupdrive_db?schema=public"

# Redis (BullMQ & Rate Limiting)
REDIS_URL="redis://localhost:6379"

# API Port & Origins
PORT=4000
NODE_ENV=development
API_BASE_URL="http://localhost:4000"
BUYER_WEB_URL="http://localhost:3000"
SELLER_WEB_URL="http://localhost:3001"
ADMIN_WEB_URL="http://localhost:3002"

# JWT Secrets (Separate for Buyer, Seller, Admin)
JWT_BUYER_SECRET="change-this-to-a-super-secret-key-for-buyers-32chars"
JWT_SELLER_SECRET="change-this-to-a-super-secret-key-for-sellers-32chars"
JWT_ADMIN_SECRET="change-this-to-a-super-secret-key-for-admins-32chars"

# TOTP MFA (Seller)
MFA_ENCRYPTION_KEY="change-this-to-32-byte-hex-secret-key"

# Payment Adapter (Mock/Test Mode)
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"
SELLER_ONBOARDING_FEE_PAISE=1999900

# SMS Provider Adapter (Mock/Fast2SMS)
SMS_PROVIDER="mock"

# AI Service (FastAPI)
AI_SERVICE_URL="http://localhost:8000"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
DEFAULT_PROVIDER="fallback"

# MCP Server
GD_MCP_TOKEN="gd_buyer_placeholder"
