{
  "name": "groupdrive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "db:server": "pnpm --filter @groupdrive/db db:server",
    "db:generate": "pnpm --filter @groupdrive/db prisma:generate",
    "db:push": "pnpm --filter @groupdrive/db prisma:push",
    "seed:demo": "pnpm --filter @groupdrive/db run seed:demo",
    "reconcile": "pnpm --filter @groupdrive/db run reconcile",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "audit": "pnpm audit --prod --audit-level high",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-postgis": "^0.2.12",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "axe-core": "^4.14.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.5",
    "lint-staged": "^17.6.0",
    "pg": "^8.23.1",
    "pg-gateway": "0.3.0-beta.4",
    "pglite-server": "^0.1.5",
    "prettier": "^3.3.3",
    "puppeteer-core": "^25.16.0",
    "turbo": "^2.0.14",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@12.16.1",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ]
  }
}
